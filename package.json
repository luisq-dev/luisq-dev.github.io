{
  "name": "cadenas-de-markov",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Guía web interactiva sobre cadenas de Markov en tiempo discreto.",
  "scripts": {
    "build": "esbuild src/entry.js --bundle --format=iife --target=es2020 --minify --outfile=script.js",
    "build:check": "npm run build && if [ \"$CI\" = \"true\" ]; then git diff --exit-code -- script.js; fi",
    "dev": "npm run build && python3 -m http.server 4173",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate \"*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.1"
  }
}
